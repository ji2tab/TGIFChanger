#!/bin/bash
# =============================================================================
# log_monitor - MMDVM to GPIO Bridge
# -----------------------------------------------------------------------------
# MMDVMHost ログをリアルタイム監視し、指定 TG の受信状態を
# Raspberry Pi の GPIO 出力ピンに反映するブリッジ。
#
# libgpiod v2 対応:
#   HIGH: gpioset をバックグラウンド起動しPIDを保持（プロセス生存中はHIGH維持）
#   LOW : そのPIDをkillして解放後、gpioset 17=0 を一瞬実行
# sysfs フォールバック対応。
# =============================================================================

VERSION="proto-1.0.5"
CONF_FILE="/etc/tgifchanger.conf"
MMDVM_CONF="/etc/mmdvmhost"

# --- 設定読込 (デフォルト値) ------------------------------------------------
LOG_DIR="/var/log/pi-star"
WATCH_SLOT="2"
WATCH_TG="1"
GPIO_PIN="17"
GPIO_BACKEND="auto"
GPIO_CHIP="auto"

[ -f "$CONF_FILE" ] && . "$CONF_FILE"

log() { echo "[$(date '+%H:%M:%S')] $*"; }

# --- 自局コールサイン自動取得 -----------------------------------------------
get_my_callsign() {
    local call=""
    [ -f "$MMDVM_CONF" ] && call=$(grep -m 1 "^Callsign=" "$MMDVM_CONF" \
        | awk -F= '{print $2}' | tr -d '\r ' | tr '[:lower:]' '[:upper:]')
    echo "$call"
}

MY_CALL=$(get_my_callsign)
[ -z "$MY_CALL" ] \
    && log "⚠️  自局コールサイン取得失敗。ループ防止が動作しません。" \
    || log "🆔 自局: $MY_CALL (自送信は無視)"

# --- GPIO バックエンド検出 --------------------------------------------------
detect_gpio_backend() {
    case "$GPIO_BACKEND" in
        libgpiod)
            command -v gpioset >/dev/null 2>&1 || { log "❌ gpioset が見つかりません。"; exit 1; }
            GPIO_MODE="libgpiod" ;;
        sysfs)
            GPIO_MODE="sysfs" ;;
        *)
            command -v gpioset >/dev/null 2>&1 && GPIO_MODE="libgpiod" || GPIO_MODE="sysfs" ;;
    esac
}

# --- libgpiod chip 自動検出 -------------------------------------------------
detect_gpio_chip() {
    [ "$GPIO_CHIP" != "auto" ] && return
    local chip
    chip=$(gpiodetect 2>/dev/null | grep -E 'pinctrl|bcm' | head -1 | awk '{print $1}')
    GPIO_CHIP="${chip:-gpiochip0}"
}

# --- libgpiod バージョン検出 ------------------------------------------------
detect_libgpiod_version() {
    local ver
    ver=$(gpioset --version 2>&1 | grep -oE 'v[0-9]+' | head -1)
    LIBGPIOD_MAJOR="${ver#v}"
    LIBGPIOD_MAJOR="${LIBGPIOD_MAJOR%%.*}"
    [ -z "$LIBGPIOD_MAJOR" ] && LIBGPIOD_MAJOR=2
}

# --- GPIO 制御 --------------------------------------------------------------
GPIO_STATE=-1
GPIOSET_PID=""   # HIGH保持プロセスのPID

set_gpio() {
    local val=$1
    [ "$val" = "$GPIO_STATE" ] && return

    case "$GPIO_MODE" in
        sysfs)
            echo "$val" > "/sys/class/gpio/gpio${GPIO_PIN}/value" 2>/dev/null
            ;;
        libgpiod)
            if [ "${LIBGPIOD_MAJOR}" -ge 2 ]; then
                # 既存の保持プロセスを停止
                if [ -n "$GPIOSET_PID" ] && kill -0 "$GPIOSET_PID" 2>/dev/null; then
                    kill "$GPIOSET_PID" 2>/dev/null
                    wait "$GPIOSET_PID" 2>/dev/null
                    GPIOSET_PID=""
                fi
                if [ "$val" = "1" ]; then
                    # バックグラウンドで起動: プロセスが生きている間 HIGH を維持
                    gpioset -c "$GPIO_CHIP" "${GPIO_PIN}=1" &
                    GPIOSET_PID=$!
                else
                    # LOW: プロセス終了後に一瞬セットして確実に解放
                    gpioset -c "$GPIO_CHIP" "${GPIO_PIN}=0" 2>/dev/null
                fi
            else
                # libgpiod v1 書式
                gpioset "$GPIO_CHIP" "${GPIO_PIN}=$val" 2>/dev/null
            fi
            ;;
    esac
    GPIO_STATE=$val
}

cleanup_gpio() {
    if [ -n "$GPIOSET_PID" ] && kill -0 "$GPIOSET_PID" 2>/dev/null; then
        kill "$GPIOSET_PID" 2>/dev/null
        wait "$GPIOSET_PID" 2>/dev/null
        GPIOSET_PID=""
    fi
    if [ "$GPIO_MODE" = "libgpiod" ] && [ "${LIBGPIOD_MAJOR}" -ge 2 ]; then
        gpioset -c "$GPIO_CHIP" "${GPIO_PIN}=0" 2>/dev/null
    elif [ "$GPIO_MODE" = "sysfs" ]; then
        echo 0 > "/sys/class/gpio/gpio${GPIO_PIN}/value" 2>/dev/null
        echo "${GPIO_PIN}" > /sys/class/gpio/unexport 2>/dev/null
    fi
}

cleanup() {
    log "⚠️  停止シグナル受信。GPIO をリセットします。"
    cleanup_gpio
    exit 0
}

trap cleanup SIGINT SIGTERM

# --- 起動チェック -----------------------------------------------------------
[ ! -d "$LOG_DIR" ] && { log "❌ ログディレクトリが見つかりません: $LOG_DIR"; exit 1; }

detect_gpio_backend
if [ "$GPIO_MODE" = "libgpiod" ]; then
    detect_gpio_chip
    detect_libgpiod_version
else
    [ ! -d "/sys/class/gpio/gpio${GPIO_PIN}" ] \
        && echo "${GPIO_PIN}" > /sys/class/gpio/export 2>/dev/null
    sleep 0.1
    echo out > "/sys/class/gpio/gpio${GPIO_PIN}/direction" 2>/dev/null
    echo 0   > "/sys/class/gpio/gpio${GPIO_PIN}/value"     2>/dev/null
fi

log "🚀 log_monitor (${VERSION}) Active"
log "   WATCH_SLOT=${WATCH_SLOT}  WATCH_TG=${WATCH_TG}"
[ "$GPIO_MODE" = "libgpiod" ] \
    && log "   GPIO=${GPIO_PIN}  BACKEND=libgpiod v${LIBGPIOD_MAJOR}  CHIP=${GPIO_CHIP}" \
    || log "   GPIO=${GPIO_PIN}  BACKEND=sysfs"

# --- ログ追従ループ ---------------------------------------------------------
get_latest_log() { ls -t "${LOG_DIR}"/MMDVM-*.log 2>/dev/null | head -1; }

current_file=""; tail_pid=""

start_tail() {
    local f=$1
    [ -n "$tail_pid" ] && kill -0 "$tail_pid" 2>/dev/null \
        && { kill "$tail_pid" 2>/dev/null; wait "$tail_pid" 2>/dev/null; }
    log "📖 ログ監視開始: $(basename "$f")"
    exec 3< <(tail -n 0 -F "$f" 2>/dev/null)
    tail_pid=$!
}

while :; do
    current_file=$(get_latest_log)
    [ -n "$current_file" ] && break
    log "ログファイル待機中..."
    sleep 5
done

start_tail "$current_file"

while :; do
    if read -r -t 5 line <&3; then
        echo "$line" | grep -q "Slot ${WATCH_SLOT}," || continue

        if echo "$line" | grep -q "received.*voice header"; then
            from_call=$(echo "$line" | sed -E 's/.*from ([^ ]+) .*/\1/' \
                        | tr '[:lower:]' '[:upper:]')
            [ -n "$MY_CALL" ] && [ "$from_call" = "$MY_CALL" ] \
                && { log "[  SKIP  ] Self ($from_call)"; continue; }
            tg=$(echo "$line" | sed -E 's/.*to TG ([0-9]+).*/\1/')
            if [ "$tg" = "$WATCH_TG" ]; then
                set_gpio 1
                log "[ RECEIVING ] TG${tg} | From: ${from_call} | GPIO${GPIO_PIN}: HIGH"
            fi

        elif echo "$line" | grep -q "end of voice transmission"; then
            tg=$(echo "$line" | sed -E 's/.*to TG ([0-9]+).*/\1/')
            if [ "$tg" = "$WATCH_TG" ]; then
                set_gpio 0
                log "[   IDLE    ] TG${tg} | GPIO${GPIO_PIN}: LOW"
            fi
        fi

    else
        latest=$(get_latest_log)
        if [ -n "$latest" ] && [ "$latest" != "$current_file" ]; then
            log "📅 ログ切替: $(basename "$latest")"
            current_file="$latest"
            set_gpio 0
            start_tail "$current_file"
        fi
    fi
done
