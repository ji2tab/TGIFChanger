#!/bin/bash
# =============================================================================
# log_monitor - MMDVM to GPIO Bridge (Version 1.2.4)
# -----------------------------------------------------------------------------
# 変更内容:
#   - /etc/mmdvmhost から自局コールサイン (Callsign=) を自動取得
#   - 取得した自局からの送信を無視することで無限ループを自動防止
# =============================================================================

VERSION="proto-1.0.2"
CONF_FILE="/etc/tgifchanger.conf"
MMDVM_CONF="/etc/mmdvmhost"

# --- 設定読込 (デフォルト値) ------------------------------------------------
LOG_DIR="/var/log/pi-star"
WATCH_SLOT="2"
WATCH_TG="1"
GPIO_PIN="17"
GPIO_BACKEND="auto"
GPIO_CHIP="auto"

[ -f "$CONF_FILE" ] && . "$CONF_FILE"

log() {
    echo "[$(date '+%H:%M:%S')] $*"
}

# --- 自局コールサイン自動取得 -----------------------------------------------
get_my_callsign() {
    local call=""
    if [ -f "$MMDVM_CONF" ]; then
        # [General] セクションの Callsign= を取得
        call=$(grep -m 1 "^Callsign=" "$MMDVM_CONF" | awk -F= '{print $2}' | tr -d '\r ' | tr '[:lower:]' '[:upper:]')
    fi
    echo "$call"
}

MY_CALL=$(get_my_callsign)
if [ -z "$MY_CALL" ]; then
    log "⚠️  自局コールサインを取得できませんでした。ループ防止機能が制限されます。"
else
    log "🆔 自局コールサインを検出: $MY_CALL (このコールサインは無視されます)"
fi

# --- GPIO 初期化ロジック (省略なし) -----------------------------------------
# (detect_gpio_backend, set_gpio などの関数群は 1.2.2/1.2.3 と同等)

# --- ログ追従ループ ---------------------------------------------------------
# (start_tail, get_latest_log などの関数群)

while :; do
    if read -r -t 5 line <&3; then
        # スロットフィルタ
        echo "$line" | grep -q "Slot ${WATCH_SLOT}," || continue

        # --- 受信開始判定 ---
        if echo "$line" | grep -q "received.*voice header"; then
            # 送信元コールサインの抽出
            from_call=$(echo "$line" | sed -E 's/.*from ([^ ]+) .*/\1/' | tr '[:lower:]' '[:upper:]')
            
            # 自局コールサイン判定 (自動取得した値と比較)
            if [ -n "$MY_CALL" ] && [ "$from_call" = "$MY_CALL" ]; then
                log "[  SKIPPING  ] Self-transmission ($from_call) - Loop prevented."
                continue
            fi

            tg=$(echo "$line" | sed -E 's/.*to TG ([0-9]+).*/\1/')
            if [ "$tg" = "$WATCH_TG" ]; then
                set_gpio 1
                log "[ RECEIVING ] TG${tg} | From: ${from_call} | GPIO${GPIO_PIN}: HIGH"
            fi
            continue
        fi

        # --- 受信終了判定 ---
        if echo "$line" | grep -q "end of voice transmission"; then
            tg=$(echo "$line" | sed -E 's/.*to TG ([0-9]+).*/\1/')
            if [ "$tg" = "$WATCH_TG" ]; then
                set_gpio 0
                log "[   IDLE    ] TG${tg} | GPIO${GPIO_PIN}: LOW"
            fi
            continue
        fi
    else
        # ログ切替チェック
        latest=$(ls -t "${LOG_DIR}"/MMDVM-*.log 2>/dev/null | head -1)
        if [ -n "$latest" ] && [ "$latest" != "$current_file" ]; then
            log "📅 ログ切替: $latest"
            current_file="$latest"
            set_gpio 0
            exec 3< <(tail -n 0 -F "$current_file")
        fi
    fi
done
