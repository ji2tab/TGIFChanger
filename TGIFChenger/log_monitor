#!/bin/bash

# --- 設定項目 ---
LOG_DIR="/var/log/pi-star"
WATCH_SLOTS="2"
GPIO_PIN="17"  # 物理11番ピン
# ---------------

init_gpio() {
    if [ ! -d /sys/class/gpio/gpio${GPIO_PIN} ]; then
        echo ${GPIO_PIN} > /sys/class/gpio/export 2>/dev/null
    fi
    sleep 0.1
    echo out > /sys/class/gpio/gpio${GPIO_PIN}/direction
    echo 0 > /sys/class/gpio/gpio${GPIO_PIN}/value
}

set_gpio() { echo $1 > /sys/class/gpio/gpio${GPIO_PIN}/value 2>/dev/null; }

cleanup() {
    echo -e "\n⚠️  Cleanup GPIO..."
    set_gpio 0
    echo ${GPIO_PIN} > /sys/class/gpio/unexport 2>/dev/null
    exit 0
}

trap cleanup SIGINT SIGTERM
init_gpio

echo "🚀 MMDVM -> GPIO Bridge Ver 1.2.2 Active"
current_file=$(ls -t "${LOG_DIR}"/MMDVM-*.log 2>/dev/null | head -1)

tail -n 0 -f "$current_file" | while read -r line; do
    if echo "$line" | grep -q "received.*voice header" && echo "$line" | grep -q "Slot $WATCH_SLOTS,"; then
        tg=$(echo "$line" | sed -E 's/.*to TG ([0-9]+).*/\1/')
        if [ "$tg" == "1" ]; then
            set_gpio 1
            echo "[ RECEIVING ] GPIO: HIGH"
        fi
    fi
    if echo "$line" | grep -q "end of voice transmission" && echo "$line" | grep -q "Slot $WATCH_SLOTS,"; then
        tg=$(echo "$line" | sed -E 's/.*to TG ([0-9]+).*/\1/')
        if [ "$tg" == "1" ]; then
            set_gpio 0
            echo "[   IDLE    ] GPIO: LOW"
        fi
    fi
done