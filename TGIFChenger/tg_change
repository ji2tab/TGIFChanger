#!/bin/bash

# --- 設定項目 ---
LOG_DIR="/var/log/pi-star"
WATCH_SLOTS="2"
RESTORE_TG="168"
RESTORE_SLOT="2"
RESTORE_DELAY=120
SCRIPT_DIR=$(dirname "$(readlink -f "$0")")
TG_CHANGE_CMD="${SCRIPT_DIR}/tg_change"
RESTORE_PID_FILE="/tmp/auto_tg_restore.pid"
# ---------------

if [ ! -x "$TG_CHANGE_CMD" ]; then
    echo "❌ エラー: $TG_CHANGE_CMD が見つかりません。"
    exit 1
fi

get_latest_log() { ls -t "${LOG_DIR}"/MMDVM-*.log 2>/dev/null | head -1; }

cancel_pending_restore() {
    if [ -f "$RESTORE_PID_FILE" ]; then
        local pid=$(cat "$RESTORE_PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null
            wait "$pid" 2>/dev/null
        fi
        rm -f "$RESTORE_PID_FILE"
    fi
}

schedule_restore() {
    cancel_pending_restore
    echo "[END] TG $1 | ${RESTORE_DELAY}秒後に復帰します..."
    (
        sleep $RESTORE_DELAY
        echo "🔄 TG ${RESTORE_TG} に自動復帰中..."
        $TG_CHANGE_CMD -${RESTORE_TG}:${RESTORE_SLOT}
        rm -f "$RESTORE_PID_FILE"
    ) &
    echo $! > "$RESTORE_PID_FILE"
}

last_file=""
last_line=0

while true; do
    current_file=$(get_latest_log)
    if [ -z "$current_file" ]; then sleep 1; continue; fi
    if [ "$current_file" != "$last_file" ]; then
        last_file="$current_file"
        last_line=$(wc -l < "$current_file")
    fi
    current_lines=$(wc -l < "$current_file" 2>/dev/null || echo 0)
    if [ "$current_lines" -gt "$last_line" ]; then
        tail -n +$((last_line + 1)) "$current_file" | while read line; do
            if echo "$line" | grep -q "end of voice transmission" && echo "$line" | grep -q "Slot $WATCH_SLOTS,"; then
                tg=$(echo "$line" | sed -E 's/.*to TG ([0-9]+).*/\1/')
                if [ "$tg" != "1" ]; then
                    schedule_restore "$tg"
                fi
            fi
        done
        last_line=$current_lines
    fi
    sleep 1
done