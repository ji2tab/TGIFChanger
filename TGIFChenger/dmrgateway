#!/bin/bash

# --- 自動取得セクション ---
if [ -f /etc/dmrgateway ]; then
    DMR_ID=$(sed -n '/\[DMR Network 4\]/,/^\[/p' /etc/dmrgateway | grep -m 1 "^Id=" | awk -F= '{print $2}' | tr -d '\r ' | cut -d'#' -f1)
fi
if [ -z "$DMR_ID" ]; then
    DMR_ID=$(grep -m 1 "^Id=" /etc/mmdvmhost | awk -F= '{print $2}' | tr -d '\r ' | cut -d'#' -f1)
fi

if [ -z "$DMR_ID" ]; then
    echo "❌ エラー: DMR ID を取得できませんでした。"
    exit 1
fi

TGIF_API="http://tgif.network:5040/api/sessions/update"
TIMEOUT=10
SCRIPT_NAME=$(basename "$0")

show_help() {
    echo "使用方法: $SCRIPT_NAME -[TG番号]:[スロット]"
    echo "例: $SCRIPT_NAME -245"
}

change_tg() {
    local slot=$1
    local tg=$2
    if ! [[ "$tg" =~ ^[0-9]+$ ]]; then
        echo "エラー: TG番号は数字で指定してください: $tg"
        return 1
    fi
    local slot_idx=$((slot - 1))
    local api_url="${TGIF_API}/${DMR_ID}/${slot_idx}/${tg}"
    echo "Changing Slot $slot to TG $tg..."
    response=$(curl -s --max-time "$TIMEOUT" "$api_url")
    if [ $? -eq 0 ]; then
        echo "✅ リクエスト送信完了"
    else
        echo "❌ エラー: 通信に失敗しました"
    fi
}

if [[ $# -eq 0 ]]; then show_help; exit 0; fi

for arg in "$@"; do
    case "$arg" in
        -h|--help) show_help ;;
        -[0-9]*)
            target="${arg#-}"
            tg="${target%:*}"
            slot="${target##*:}"
            [[ "$slot" == "$tg" ]] && slot=1
            change_tg "$slot" "$tg"
            ;;
        *) show_help ;;
    esac
done